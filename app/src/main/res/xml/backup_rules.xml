<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31 (file ignored on 31+).
   See https://developer.android.com/guide/topics/data/autobackup
   for details.

   Локальные данные пользователя (счёт, лимиты, uid/username) лежат в
   зашифрованном файле secure_shared_prefs и исторически в
   MySharedPreferences; Firebase/GMS пишут служебные prefs-файлы.
   Всё исключено из резервной копии: зашифрованные prefs
   восстанавливаются на другом устройстве без мастер-ключа и
   расшифровать их нельзя; данные пользователя хранятся в Firebase RTDB
   и при восстановлении «мигрируют» между аккаунтами.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_shared_prefs.xml" />
    <exclude domain="sharedpref" path="MySharedPreferences.xml" />
    <exclude domain="sharedpref" path="google_app_measure.xml" />
    <exclude domain="sharedpref" path="firebase-storage-internal-0.xml" />
    <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
    <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
</full-backup-content>
