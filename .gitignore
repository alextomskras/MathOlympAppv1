```
# Generated by Android Studio
.gradle/
/build/
captures/
*.keystore
*.jks

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by for example:
# ./gradlew :app:proguardRelease
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild/

# User-specific configurations
.idea/
*.iml
*.iws

# Code coverage reports
coverage/
*.ec
*.lcov

# Unit test reports
test-results/
*.xml

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
gen/
out/

# Debug symbols
.map
.sym

# Temporary files
*.tmp
*.temp
*.swp

# Environment variables
.env
.env.local
*.env.*

# OS generated files
.DS_Store
Thumbs.db

# Python related (if any Python components)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Node.js related (if any JavaScript components)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE specific
.vscode/
*.swp
*.swo

# MyPy cache
.mypy_cache/
```